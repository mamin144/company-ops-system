# Copy to .env and adjust. Docker Compose supplies DATABASE_URL itself;
# this file is only used when running the API directly on the host.
# Via the Dockerized PostgreSQL (published on localhost:5433):
DATABASE_URL=postgresql://cos:change-me@localhost:5433/cos_db
# Via your own local PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# JWT_SECRET=change-me-in-production
