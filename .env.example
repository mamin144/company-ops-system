# Docker Compose variables — copy to .env and change the password.
# Used only for the local Docker PostgreSQL container (NOT production secrets).
POSTGRES_USER=cos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cos_db

# ---------------------------------------------------------------------------
# apps/api/.env (host development only — Docker supplies DATABASE_URL itself)
# ---------------------------------------------------------------------------
# Host dev against the Dockerized PostgreSQL (published on 127.0.0.1:5433):
# DATABASE_URL=postgresql://cos:change-me@localhost:5433/cos_db
# Host dev against your own local PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
#
# Optional (API otherwise generates/stores its own secret):
# JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# CORS allowlist (API). Unset = reflect request origin (local dev / LAN use).
# For any Internet-facing deployment, set an explicit comma-separated list:
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# ---------------------------------------------------------------------------
# CORS_ORIGINS=
